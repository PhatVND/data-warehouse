# ============================================================================
# .env.example — copy to .env and adjust as needed.
# Used by: run_pipeline.bat, run_pipeline.sh, run_pipeline_rollback.* and
# (optionally) Pentaho via -param=KEY=VALUE in the .bat/.sh wrappers.
# ============================================================================

# --- PostgreSQL connection ---
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=crypto_dw_etl
PG_USER=crypto_etl
PG_PASSWORD=crypto_etl

# --- Orchestration toggles ---
# 0 = use SQL fallback (sql/02_transform_fallback.sql)
# 1 = use Pentaho 02_transform.kjb (requires PENTAHO_HOME)
USE_PENTAHO=0

# 0 = load staging.ohlcv_raw via psql \copy from raw/*.csv (Phase A, MVP default)
# 1 = run Pentaho 01_clean.kjb (Phase B, after TV2 finishes)
USE_PENTAHO_CLEAN=0

# --- Pentaho ---
# Path to data-integration directory (contains Kitchen.bat / kitchen.sh).
# Leave empty if USE_PENTAHO=0 and USE_PENTAHO_CLEAN=0.
PENTAHO_HOME=

# --- Python ---
# Python executable to use. On Windows, "python" usually resolves correctly.
# On Linux, prefer "python3".
PYTHON_BIN=python3
